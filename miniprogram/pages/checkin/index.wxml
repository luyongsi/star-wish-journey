<!-- pages/checkin/index.wxml -->
<view class="checkin-page">
  <!-- D1 今天要做 -->
  <view class="section" wx:if="{{today.length > 0}}">
    <view class="section-header">
      <text class="section-title">今天要做</text>
      <text class="section-count">{{today.length}}</text>
    </view>

    <view class="card-list">
      <view
        class="task-card {{item.overdueDays > 0 ? 'task-overdue' : ''}}"
        wx:for="{{today}}"
        wx:key="_id"
      >
        <text class="task-icon">{{item.icon}}</text>
        <view class="task-info">
          <text class="task-title">{{item.wishTitle || item.title}}</text>
          <text class="task-sub">{{item.subText}}</text>
        </view>
        <view class="btn-primary task-btn" data-wish="{{item}}" bindtap="handleOpenCheckIn">
          <text>去完成</text>
        </view>
      </view>
    </view>
  </view>

  <!-- D2 待打卡 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">待打卡</text>
      <text class="section-count">{{ongoing.length}}</text>
    </view>

    <view class="card-list" wx:if="{{ongoing.length > 0}}">
      <view class="task-card" wx:for="{{ongoing}}" wx:key="_id">
        <text class="task-icon">{{item.icon}}</text>
        <view class="task-info">
          <text class="task-title">{{item.wishTitle || item.title}}</text>
          <text class="task-sub">{{item.subText}}</text>
        </view>
        <view class="btn-secondary task-btn" data-wish="{{item}}" bindtap="handleOpenCheckIn">
          <text>去打卡</text>
        </view>
      </view>
    </view>

    <view class="empty-inline" wx:elif="{{!loading}}">
      <text>暂无待打卡的愿望，去抽取一个吧～</text>
    </view>
  </view>

  <!-- D3 已完成 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">已完成</text>
      <text class="section-count">{{completed.length}}</text>
    </view>

    <view class="card-list" wx:if="{{completed.length > 0}}">
      <view
        class="done-card"
        wx:for="{{completed}}"
        wx:key="_id"
        data-wish="{{item}}"
        bindtap="handleViewWishDetail"
      >
        <view class="done-cover">
          <image
            wx:if="{{item.coverUrl}}"
            class="done-cover-img"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            lazy-load
          />
          <text wx:else class="done-cover-icon">{{item.icon}}</text>
        </view>
        <view class="done-info">
          <text class="done-title">{{item.wishTitle || item.title}}</text>
          <text class="done-sub">{{item.subText}}</text>
        </view>
        <text class="done-arrow">›</text>
      </view>
    </view>

    <empty-state
      wx:elif="{{!loading}}"
      icon="📸"
      text="还没有打卡记录"
      subText="完成愿望后会在这里展示"
    />
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>

<!-- D4 完成抽屉 -->
<view class="overlay" wx:if="{{showCheckInPanel}}" bindtap="handleClosePanel">
  <view class="bottom-panel" catchtap="handleStopPropagation">
    <view class="panel-header">
      <text class="panel-title">这次感觉如何？</text>
      <text class="panel-close" bindtap="handleClosePanel">×</text>
    </view>

    <view class="panel-body">
      <!-- 愿望名 -->
      <view class="panel-wish">
        <text class="panel-wish-icon">{{currentIcon}}</text>
        <text class="panel-wish-title">{{currentWish.title}}</text>
      </view>

      <!-- 备注 -->
      <text class="panel-label">备注（选填）</text>
      <textarea
        class="panel-textarea"
        placeholder="记录这个美好时刻…"
        placeholder-class="panel-placeholder"
        maxlength="500"
        value="{{note}}"
        disabled="{{submitting}}"
        bindinput="handleNoteInput"
      />

      <!-- 媒体 -->
      <text class="panel-label">照片/视频（选填）</text>
      <media-uploader
        maxCount="9"
        mediaList="{{mediaList}}"
        bind:change="handleMediaChange"
      />

      <!-- 位置 -->
      <text class="panel-label">位置（选填）</text>
      <view class="location-row" wx:if="{{!location}}">
        <view class="location-add" bindtap="handleChooseLocation">
          <text>📍 添加位置</text>
        </view>
      </view>
      <view class="location-filled" wx:else>
        <text class="location-icon">📍</text>
        <text class="location-name">{{location.name}}</text>
        <text class="location-remove" bindtap="handleRemoveLocation">移除</text>
      </view>

      <!-- 主按钮 -->
      <view
        class="btn-primary panel-submit {{submitting ? 'btn-disabled' : ''}}"
        bindtap="handleSubmitCheckIn"
      >
        <text>{{submitting && !isSkipping ? uploadText : '✅ 标记完成'}}</text>
      </view>

      <!-- 次按钮 -->
      <view
        class="panel-skip {{submitting ? 'btn-disabled' : ''}}"
        bindtap="handleSkip"
      >
        <text>{{submitting && isSkipping ? '处理中...' : '先跳过，直接完成'}}</text>
      </view>
    </view>
  </view>
</view>
