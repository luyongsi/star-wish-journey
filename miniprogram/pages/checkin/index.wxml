<!-- pages/checkin/index.wxml -->
<view class="checkin-page">
  <!-- 待打卡区 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">⏳ 待打卡</text>
      <text class="section-count">{{ongoing.length}}</text>
    </view>

    <view class="ongoing-list" wx:if="{{ongoing.length > 0}}">
      <view class="ongoing-item" wx:for="{{ongoing}}" wx:key="_id">
        <view class="ongoing-info">
          <text class="ongoing-icon">{{item.icon}}</text>
          <text class="ongoing-title">{{item.title}}</text>
        </view>
        <view class="btn-primary ongoing-btn" data-wish="{{item}}" bindtap="handleOpenCheckIn">
          <text>去打卡</text>
        </view>
      </view>
    </view>

    <view class="empty-inline" wx:else>
      <text>暂无待打卡的愿望，去抽取一个吧～</text>
    </view>
  </view>

  <!-- 已完成区 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">✅ 已完成</text>
      <text class="section-count">{{completed.length}}</text>
    </view>

    <view class="completed-list" wx:if="{{completed.length > 0}}">
      <checkin-card
        wx:for="{{completed}}"
        wx:key="_id"
        checkIn="{{item}}"
        bind:tap="handleViewCheckIn"
      />
    </view>

    <empty-state
      wx:elif="{{!loading}}"
      icon="📸"
      text="还没有打卡记录"
      subText="完成愿望后会在这里展示"
    />
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>

<!-- 打卡操作面板 -->
<view class="overlay" wx:if="{{showCheckInPanel}}" bindtap="handleCloseCheckIn">
  <view class="bottom-panel" catchtap="handleStopPropagation">
    <view class="panel-header">
      <text class="panel-title">完成打卡</text>
      <text class="panel-close" bindtap="handleCloseCheckIn">×</text>
    </view>
    <view class="panel-body">
      <!-- 愿望标题 -->
      <view class="panel-wish-title">
        <text>{{currentWish.title}}</text>
      </view>

      <!-- 媒体上传 -->
      <text class="panel-label">添加照片/视频</text>
      <media-uploader
        maxCount="9"
        mediaList="{{mediaList}}"
        bind:change="handleMediaChange"
      />

      <!-- 文字备注 -->
      <text class="panel-label">打卡备注</text>
      <textarea
        class="panel-textarea"
        placeholder="记录这个美好时刻..."
        maxlength="500"
        value="{{note}}"
        bindinput="handleNoteInput"
      />

      <!-- 提交 -->
      <view
        class="btn-primary {{submitting ? 'btn-disabled' : ''}}"
        bindtap="handleSubmitCheckIn"
      >
        <text>{{submitting ? '提交中...' : '完成打卡'}}</text>
      </view>
    </view>
  </view>
</view>
