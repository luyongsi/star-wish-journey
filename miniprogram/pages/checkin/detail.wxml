<!-- pages/checkin/detail.wxml -->
<view class="detail-page" wx:if="{{checkIn}}">
  <!-- 愿望标题 -->
  <view class="wish-title-bar">
    <text class="wish-icon">{{icon}}</text>
    <text class="wish-title-text">{{wish.title || '愿望打卡'}}</text>
  </view>

  <!-- 媒体展示 -->
  <view class="media-section" wx:if="{{mediaUrls.length > 0}}">
    <view class="media-grid">
      <view
        class="media-item"
        wx:for="{{mediaUrls}}"
        wx:key="fileId"
        data-index="{{index}}"
        bindtap="handlePreviewMedia"
      >
        <image
          class="media-img"
          src="{{item.thumbUrl || item.url}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="video-badge" wx:if="{{item.type === 'video'}}">
          <text>▶</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 文字备注 -->
  <view class="note-section" wx:if="{{checkIn.note}}">
    <text class="section-label">打卡备注</text>
    <view class="note-content">
      <text>{{checkIn.note}}</text>
    </view>
  </view>

  <!-- 位置信息 -->
  <view class="location-section" wx:if="{{checkIn.location && checkIn.location.name}}">
    <text class="section-label">位置</text>
    <view class="location-content">
      <text class="location-icon">📍</text>
      <text class="location-name">{{checkIn.location.name}}</text>
    </view>
  </view>

  <!-- 时间 -->
  <view class="time-section">
    <text class="time-text">{{dateStr}}</text>
  </view>

  <!-- 操作 -->
  <view class="action-section">
    <view class="btn-danger" bindtap="handleDelete">
      <text>删除打卡</text>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
