/* pages/checkin/index.wxss */
.checkin-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3436;
  margin-right: 12rpx;
}

.section-count {
  font-size: 24rpx;
  line-height: 1.4;
  color: #FFFFFF;
  background: #FF6B9D;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  min-width: 40rpx;
  box-sizing: border-box;
  text-align: center;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* D1 / D2 任务卡片 */
.task-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
}

.task-overdue {
  border-left: 6rpx solid #E84393;
}

.task-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.task-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-sub {
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 6rpx;
}

.task-btn {
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.empty-inline {
  text-align: center;
  padding: 40rpx;
  color: #B2BEC3;
  font-size: 26rpx;
  background: #FFF5F8;
  border-radius: 24rpx;
}

/* D3 已完成卡片 */
.done-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
}

.done-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #FFF5F8;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.done-cover-img {
  width: 100%;
  height: 100%;
}

.done-cover-icon {
  font-size: 44rpx;
}

.done-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.done-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.done-sub {
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.done-arrow {
  font-size: 40rpx;
  color: #B2BEC3;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #B2BEC3;
  font-size: 26rpx;
}

/* D4 完成抽屉 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.bottom-panel {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2D3436;
}

.panel-close {
  font-size: 48rpx;
  color: #B2BEC3;
  padding: 0 8rpx;
}

.panel-body {
  display: flex;
  flex-direction: column;
}

.panel-wish {
  display: flex;
  align-items: center;
  background: #FFF5F8;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.panel-wish-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.panel-wish-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B9D;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-label {
  font-size: 28rpx;
  color: #636E72;
  margin-bottom: 16rpx;
  margin-top: 16rpx;
  display: block;
}

.panel-textarea {
  width: 100%;
  height: 160rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 8rpx;
  margin-top: 8rpx;
}

.panel-placeholder {
  color: #B2BEC3;
}

.location-row {
  margin-bottom: 8rpx;
}

.location-add {
  display: inline-block;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: #FFF5F8;
  border: 2rpx dashed #FFE0EC;
  font-size: 26rpx;
  color: #FF6B9D;
}

.location-filled {
  display: flex;
  align-items: center;
  background: #FFF5F8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.location-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.location-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #636E72;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-remove {
  font-size: 24rpx;
  color: #B2BEC3;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.panel-submit {
  margin-top: 40rpx;
  font-size: 32rpx;
  padding: 26rpx 0;
}

.panel-skip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #B2BEC3;
  padding: 20rpx 0;
}
