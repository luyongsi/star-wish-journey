/* pages/memory/index.wxss */
.memory-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ===== 分段控件 ===== */
.seg {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #636E72;
  transition: all 0.2s;
}

.seg-item-on {
  background: #FF6B9D;
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 时间线 ===== */
.timeline {
  padding-left: 8rpx;
}

.timeline-group {
  margin-bottom: 16rpx;
}

.month-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.month-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF6B9D;
  margin-right: 16rpx;
}

.month-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B9D;
}

.month-items {
  padding-left: 32rpx;
  border-left: 2rpx solid #FFE0EC;
  margin-left: 7rpx;
}

.memory-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  margin-left: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
}

.memory-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: #FFF5F8;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-placeholder text {
  font-size: 48rpx;
}

.memory-content {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.memory-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.memory-date {
  font-size: 24rpx;
  color: #636E72;
}

.memory-dot {
  font-size: 24rpx;
  color: #B2BEC3;
  margin: 0 8rpx;
}

.memory-media {
  font-size: 24rpx;
  color: #B2BEC3;
}

.memory-note {
  font-size: 24rpx;
  color: #636E72;
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-arrow {
  font-size: 40rpx;
  color: #B2BEC3;
  flex-shrink: 0;
  padding-left: 12rpx;
}

.load-more,
.no-more {
  text-align: center;
  padding: 32rpx;
  color: #B2BEC3;
  font-size: 26rpx;
}

.load-more text {
  color: #FF6B9D;
}

/* ===== 成就 ===== */
.report-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FF6B9D, #FF9ABF);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.24);
}

.report-entry-main {
  flex: 1;
  min-width: 0;
}

.report-entry-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.report-entry-summary {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.report-entry-link {
  font-size: 24rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.ach-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ach-head-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}

.ach-head-count {
  font-size: 24rpx;
  color: #FF6B9D;
}

.ach-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.ach-item {
  width: calc(33.333% - 16rpx);
  margin: 0 8rpx 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
  box-sizing: border-box;
}

.ach-item-done {
  background: #FFF5F8;
}

.ach-icon {
  font-size: 52rpx;
  line-height: 1.2;
}

.ach-icon-locked {
  filter: grayscale(1);
  opacity: 0.35;
}

.ach-name {
  font-size: 24rpx;
  color: #2D3436;
  margin-top: 8rpx;
  text-align: center;
}

.ach-name-locked {
  color: #B2BEC3;
}

.ach-progress {
  font-size: 20rpx;
  color: #B2BEC3;
  margin-top: 4rpx;
  text-align: center;
}

/* ===== 足迹 ===== */
.map-wrap {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.12);
}

.footprint-map {
  width: 100%;
  height: 55vh;
}

.map-reset {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #FF6B9D;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.city-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
}

.city-summary {
  font-size: 26rpx;
  color: #636E72;
  padding: 24rpx 0 16rpx;
  border-bottom: 2rpx solid #FFF0F5;
}

.city-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 8rpx;
  border-bottom: 2rpx solid #FFF0F5;
  border-radius: 16rpx;
}

.city-item:last-child {
  border-bottom: none;
}

.city-item-active {
  background: #FFF5F8;
}

.city-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.city-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.city-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.city-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3436;
}

.city-last {
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 4rpx;
}

.city-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.city-count {
  font-size: 24rpx;
  color: #FF6B9D;
}

.city-arrow {
  font-size: 32rpx;
  color: #B2BEC3;
  margin-left: 12rpx;
}

/* ===== 通用 ===== */
.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #B2BEC3;
  font-size: 26rpx;
}

.retry {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #FF6B9D;
}
