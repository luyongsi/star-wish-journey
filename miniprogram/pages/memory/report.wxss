/* pages/memory/report.wxss */
.report-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

/* ===== I1 头部 ===== */
.report-header {
  text-align: center;
  padding: 48rpx 24rpx 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FF6B9D, #FFA7C6);
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.24);
  margin-bottom: 24rpx;
}

.header-year {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.header-title {
  display: block;
  font-size: 54rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 12rpx;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 16rpx;
}

/* ===== 卡片 ===== */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 24rpx;
}

.card-title-inline {
  font-size: 28rpx;
  color: #636E72;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ===== I2 核心数字 ===== */
.stat-row {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #FF6B9D;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: #636E72;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 64rpx;
  background: #FFF0F5;
}

/* ===== I3 月度分布 ===== */
.chart {
  padding-top: 8rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  height: 300rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.chart-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.chart-bar {
  width: 24rpx;
  background: #FFC7DC;
  border-radius: 6rpx 6rpx 0 0;
}

.chart-bar-top {
  background: #FF6B9D;
}

.chart-label {
  font-size: 18rpx;
  color: #B2BEC3;
  margin-top: 10rpx;
}

.chart-note {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #636E72;
  margin-top: 20rpx;
}

/* ===== I4 最爱的分类 ===== */
.category-value {
  display: flex;
  align-items: center;
}

.category-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.category-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3436;
}

.category-count {
  font-size: 26rpx;
  color: #636E72;
}

/* ===== I5 最佳瞬间 ===== */
.moment-body {
  display: flex;
  align-items: center;
}

.moment-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #FFF5F8;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.moment-img {
  width: 100%;
  height: 100%;
}

.moment-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.moment-info {
  flex: 1;
  min-width: 0;
}

.moment-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.moment-date {
  display: block;
  font-size: 24rpx;
  color: #B2BEC3;
  margin-top: 10rpx;
}

.moment-arrow {
  font-size: 40rpx;
  color: #B2BEC3;
  padding-left: 12rpx;
}

/* ===== I6 保存长图 ===== */
.save-btn {
  margin-top: 8rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF9ABF);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.28);
}

.save-btn-disabled {
  opacity: 0.6;
}

.save-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #B2BEC3;
  margin-top: 16rpx;
}

/* ===== 隐藏 canvas（必须保留在布局内，移出可视区而非 display:none） ===== */
.report-canvas {
  position: fixed;
  top: 0;
  left: -9999px;
  width: 375px;
  height: 700px;
}

.loading {
  text-align: center;
  padding: 160rpx 0;
  color: #B2BEC3;
  font-size: 26rpx;
}
