/* pages/pair/bind.wxss */
.pair-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F8 0%, #FFFFFF 50%, #FFF5F8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
  margin-bottom: 100rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8EB3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.3);
  margin-bottom: 32rpx;
}

.logo-emoji {
  font-size: 72rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF6B9D;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: #B2BEC3;
}

.action-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.divider-text {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
  width: 100%;
}

.divider-text .line {
  flex: 1;
  height: 1rpx;
  background: #FFE0EC;
}

.divider-text text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #B2BEC3;
}

.code-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.12);
}

.code-label {
  font-size: 28rpx;
  color: #636E72;
  margin-bottom: 24rpx;
}

.code-display {
  padding: 24rpx 64rpx;
  background: #FFF5F8;
  border-radius: 24rpx;
  border: 4rpx dashed #FFB3CD;
}

.code-number {
  font-size: 72rpx;
  font-weight: 700;
  color: #FF6B9D;
  letter-spacing: 16rpx;
}

.code-hint {
  font-size: 24rpx;
  color: #B2BEC3;
  margin-top: 24rpx;
  text-align: center;
}

.input-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.08);
}

.input-label {
  font-size: 28rpx;
  color: #636E72;
  margin-bottom: 20rpx;
  display: block;
}

.code-input {
  width: 100%;
  height: 100rpx;
  background: #FFF5F8;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #FF6B9D;
  letter-spacing: 16rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ===== 等待状态指示器 ===== */
.waiting-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

.waiting-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.waiting-dots .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF6B9D;
  animation: dotPulse 1.4s infinite ease-in-out both;
}

.waiting-dots .dot1 {
  animation-delay: -0.32s;
}

.waiting-dots .dot2 {
  animation-delay: -0.16s;
}

.waiting-dots .dot3 {
  animation-delay: 0s;
}

@keyframes dotPulse {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.waiting-text {
  font-size: 26rpx;
  color: #FF6B9D;
  font-weight: 500;
}

/* ===== 纯文字按钮 ===== */
.btn-text {
  background: transparent;
  color: #B2BEC3;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  text-align: center;
}

.btn-text::after {
  border: none;
}
