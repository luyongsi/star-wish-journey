<!-- pages/profile/index.wxml -->
<view class="profile-page" wx:if="{{coupleInfo}}">
  <!-- F1 情侣卡 -->
  <view class="couple-card">
    <view class="avatar-pair">
      <view class="avatar-item" bindtap="handleGoEdit">
        <image
          wx:if="{{myDisplay.avatarUrl}}"
          class="avatar-img"
          src="{{myDisplay.avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar-placeholder">
          <text>{{myDisplay.placeholder}}</text>
        </view>
        <text class="avatar-name">{{myDisplay.name}}</text>
      </view>

      <view class="heart-connector">
        <text class="heart-icon">❤️</text>
      </view>

      <view class="avatar-item" bindtap="handleGoEdit">
        <image
          wx:if="{{partnerDisplay.avatarUrl}}"
          class="avatar-img"
          src="{{partnerDisplay.avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar-placeholder">
          <text>{{partnerDisplay.placeholder}}</text>
        </view>
        <text class="avatar-name">{{partnerDisplay.name}}</text>
      </view>
    </view>

    <view class="anniversary">
      <text class="anni-days">{{anniversaryDays}}</text>
      <text class="anni-label">天</text>
    </view>
    <text class="anni-text">已在一起</text>
  </view>

  <!-- 未设置昵称引导行 -->
  <view class="edit-guide" wx:if="{{showEditGuide}}" bindtap="handleGoEdit">
    <text class="guide-text">设置昵称和头像</text>
    <text class="guide-arrow">→</text>
  </view>

  <!-- F2 数据卡 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{stats.wishTotal}}</text>
      <text class="stat-label">愿望</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.wishCompleted}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.checkInTotal}}</text>
      <text class="stat-label">打卡</text>
    </view>
  </view>

  <!-- F3 菜单 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="handleGoEdit">
      <text class="menu-icon">✏️</text>
      <text class="menu-text">编辑资料</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="handleGoMemory">
      <text class="menu-icon">📖</text>
      <text class="menu-text">回忆录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="handleGoInspiration">
      <text class="menu-icon">📚</text>
      <text class="menu-text">愿望灵感库</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="handleGoSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
