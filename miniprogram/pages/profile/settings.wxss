/* pages/profile/settings.wxss */
.settings-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.settings-group {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #FFF5F8;
}

.settings-item:last-child {
  border-bottom: none;
}

.item-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.item-text {
  flex: 1;
  font-size: 30rpx;
  color: #2D3436;
}

.danger-text {
  color: #E84393;
}

.item-arrow {
  font-size: 40rpx;
  color: #B2BEC3;
}

.danger-group {
  border: 2rpx solid rgba(232, 67, 147, 0.1);
}

.version-info {
  text-align: center;
  padding: 48rpx;
  color: #B2BEC3;
  font-size: 24rpx;
}

/* 确认弹窗 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-modal {
  width: 80%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  animation: modalPop 0.3s ease;
}

@keyframes modalPop {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2D3436;
  display: block;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #636E72;
  line-height: 1.6;
  display: block;
  margin-bottom: 32rpx;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-actions .btn-secondary,
.modal-actions .btn-danger {
  flex: 1;
  font-size: 30rpx;
}
