/* pages/profile/index.wxss */
.profile-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 情侣信息卡 */
.couple-card {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8EB3 100%);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.2);
}

.avatar-pair {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
}

.avatar-placeholder text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.avatar-name {
  max-width: 160rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.heart-connector {
  margin: 0 32rpx;
}

.heart-icon {
  font-size: 40rpx;
  animation: heartbeat 1.5s ease-in-out infinite;
}

@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

.anniversary {
  display: flex;
  align-items: baseline;
}

.anni-days {
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.anni-label {
  font-size: 32rpx;
  color: #FFFFFF;
  margin-left: 8rpx;
}

.anni-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 未设置昵称引导行 */
.edit-guide {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF5F8;
  border: 2rpx solid #FFE0EC;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.guide-text {
  font-size: 28rpx;
  color: #FF6B9D;
}

.guide-arrow {
  font-size: 28rpx;
  color: #FF6B9D;
  margin-left: 12rpx;
}

/* 统计卡 */
.stats-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF6B9D;
}

.stat-label {
  font-size: 24rpx;
  color: #636E72;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  background: #FFE0EC;
  margin: 0 16rpx;
}

/* 菜单列表 */
.menu-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #FFF5F8;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #2D3436;
}

.menu-arrow {
  font-size: 40rpx;
  color: #B2BEC3;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #B2BEC3;
  font-size: 26rpx;
}
