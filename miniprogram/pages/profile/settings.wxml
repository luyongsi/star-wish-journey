<!-- pages/profile/settings.wxml -->
<view class="settings-page">
  <!-- 设置项列表 -->
  <view class="settings-group">
    <view class="settings-item" bindtap="handleAbout">
      <text class="item-icon">ℹ️</text>
      <text class="item-text">关于我们</text>
      <text class="item-arrow">›</text>
    </view>
  </view>

  <!-- 危险操作 -->
  <view class="settings-group danger-group">
    <view class="settings-item" bindtap="handleShowUnbind">
      <text class="item-icon">💔</text>
      <text class="item-text danger-text">解除贴贴</text>
      <text class="item-arrow">›</text>
    </view>
  </view>

  <!-- 版本号 -->
  <view class="version-info">
    <text>心愿拾光 v1.1.0</text>
  </view>
</view>

<!-- 解除贴贴确认弹窗 -->
<view class="overlay" wx:if="{{showUnbindConfirm}}" bindtap="handleCancelUnbind">
  <view class="confirm-modal" catchtap="handleStopPropagation">
    <view class="modal-icon">💔</view>
    <text class="modal-title">确认解除贴贴？</text>
    <text class="modal-desc">解除后，你们的愿望和打卡记录仍保留，</text>
    <text class="modal-desc">但将无法继续共同管理。此操作不可撤销。</text>
    <view class="modal-actions">
      <view class="btn-secondary" bindtap="handleCancelUnbind">
        <text>取消</text>
      </view>
      <view class="btn-danger" bindtap="handleConfirmUnbind">
        <text>{{unbinding ? '处理中...' : '确认解除'}}</text>
      </view>
    </view>
  </view>
</view>
