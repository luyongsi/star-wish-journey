/* components/draw-animation/draw-animation.wxss */
.draw-animation-container {
  position: relative;
  width: 100%;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.draw-card {
  width: 80%;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF5F8 100%);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.16);
  position: relative;
  z-index: 2;
}

.draw-card.animating {
  animation: cardShake 0.3s ease-in-out infinite;
}

.draw-card.settled {
  animation: cardSettle 0.5s ease-out;
}

@keyframes cardShake {
  0%, 100% { transform: translateX(0) scale(1); }
  25% { transform: translateX(-8rpx) scale(0.98); }
  75% { transform: translateX(8rpx) scale(0.98); }
}

@keyframes cardSettle {
  0% { transform: scale(0.9); opacity: 0.7; }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.draw-card-icon {
  margin-bottom: 24rpx;
}

.draw-emoji {
  font-size: 80rpx;
}

.draw-card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3436;
  margin-bottom: 12rpx;
}

.draw-card-desc {
  font-size: 26rpx;
  color: #636E72;
  line-height: 1.5;
}

.draw-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.draw-empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.draw-empty-text {
  font-size: 28rpx;
  color: #B2BEC3;
}

.sparkles {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 1;
}

.sparkle {
  position: absolute;
  font-size: 40rpx;
  animation: sparkleFloat 1s ease-in-out infinite;
}

.s1 { top: 20%; left: 15%; animation-delay: 0s; }
.s2 { top: 60%; right: 15%; animation-delay: 0.3s; }
.s3 { bottom: 20%; left: 40%; animation-delay: 0.6s; }

@keyframes sparkleFloat {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.6; }
  50% { transform: translateY(-20rpx) scale(1.2); opacity: 1; }
}
