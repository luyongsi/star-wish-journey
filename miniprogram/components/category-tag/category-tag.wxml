<!-- components/category-tag/category-tag.wxml -->
<view class="category-tag-list">
  <scroll-view scroll-x class="tag-scroll" enhanced show-scrollbar="{{false}}">
    <view class="tag-scroll-inner">
      <view
        class="tag-item {{selected === item.key ? 'tag-active' : ''}}"
        wx:for="{{categoryList}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="handleSelect"
      >
        <text class="tag-icon">{{item.icon}}</text>
        <text class="tag-label">{{item.label}}</text>
      </view>
    </view>
  </scroll-view>
</view>
