/* components/empty-state/empty-state.wxss */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #636E72;
  margin-bottom: 8rpx;
}

.empty-sub-text {
  font-size: 26rpx;
  color: #B2BEC3;
  text-align: center;
  line-height: 1.6;
}

.empty-action {
  margin-top: 32rpx;
  padding: 20rpx 56rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8EB3 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.3);
}
