/* app.wxss — 全局样式：粉色系主题、通用类 */

/* ===== 主题变量 ===== */
page {
  --color-primary: #FF6B9D;
  --color-primary-light: #FFB3CD;
  --color-primary-bg: #FFF5F8;
  --color-secondary: #6C5CE7;
  --color-success: #00B894;
  --color-warning: #FDCB6E;
  --color-danger: #E84393;
  --color-info: #74B9FF;

  --color-text: #2D3436;
  --color-text-secondary: #636E72;
  --color-text-placeholder: #B2BEC3;
  --color-text-inverse: #FFFFFF;

  --color-bg: #FFF5F8;
  --color-bg-card: #FFFFFF;
  --color-bg-gray: #F5F5F5;
  --color-border: #FFE0EC;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  --shadow-sm: 0 2rpx 8rpx rgba(255, 107, 157, 0.08);
  --shadow-md: 0 4rpx 16rpx rgba(255, 107, 157, 0.12);
  --shadow-lg: 0 8rpx 32rpx rgba(255, 107, 157, 0.16);

  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

/* ===== 通用布局 ===== */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }

/* ===== 间距 ===== */
.mt-xs { margin-top: 8rpx; }
.mt-sm { margin-top: 16rpx; }
.mt-md { margin-top: 24rpx; }
.mt-lg { margin-top: 32rpx; }
.mt-xl { margin-top: 48rpx; }
.mb-sm { margin-bottom: 16rpx; }
.mb-md { margin-bottom: 24rpx; }
.mb-lg { margin-bottom: 32rpx; }
.ml-sm { margin-left: 16rpx; }
.ml-md { margin-left: 24rpx; }
.mr-sm { margin-right: 16rpx; }
.mr-md { margin-right: 24rpx; }
.p-sm { padding: 16rpx; }
.p-md { padding: 24rpx; }
.p-lg { padding: 32rpx; }
.px-md { padding-left: 24rpx; padding-right: 24rpx; }
.py-md { padding-top: 24rpx; padding-bottom: 24rpx; }

/* ===== 文字 ===== */
.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-danger { color: var(--color-danger); }
.text-center { text-align: center; }
.text-bold { font-weight: 600; }
.text-sm { font-size: 24rpx; }
.text-md { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 40rpx; }
.text-xxl { font-size: 56rpx; }

/* ===== 卡片 ===== */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

/* ===== 按钮 ===== */
.btn-primary {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8EB3 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 157, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #FFFFFF;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary-light);
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.btn-secondary::after {
  border: none;
}

.btn-danger {
  background: #FFFFFF;
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger);
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-danger::after {
  border: none;
}

.btn-disabled {
  opacity: 0.5;
}

/* ===== 输入框 ===== */
.input-base {
  background: var(--color-bg-gray);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

/* ===== 状态色 ===== */
.status-pending { color: var(--color-info); background: rgba(116, 185, 255, 0.1); }
.status-ongoing { color: var(--color-warning); background: rgba(253, 203, 110, 0.15); }
.status-completed { color: var(--color-text-placeholder); background: rgba(178, 190, 195, 0.1); }

.status-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: var(--spacing-md) 0;
}

/* ===== 安全区 ===== */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 滚动容器 ===== */
.scroll-container {
  height: 100vh;
  box-sizing: border-box;
}
